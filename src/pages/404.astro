---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { navigation, profile } from '../data/profile';
import { withBase } from '../utils/url';
---

<BaseLayout title={`Page not found | ${profile.name}`} description="This page does not exist." noindex>
  <section class="not-found">
    <div class="container">
      <p class="meta">404</p>
      <h1 class="serif">Page not found</h1>
      <p class="lede">This page doesn't exist. It may have moved, or the link may be mistyped.</p>
      <div class="actions">
        <a class="btn btn--primary" href={withBase('')}>
          Go to the homepage <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn" href={withBase(profile.resumePath)} download={profile.resumeFileName}>
          <Icon name="download" size={16} /> Download resume
        </a>
      </div>
      <nav aria-label="Sections" class="nf-nav">
        <h2 class="label">Jump to</h2>
        <ul role="list">
          {
            navigation.map((n) => (
              <li>
                <a class="text-link" href={`${withBase('')}#${n.id}`}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 12vh, 8rem);
  }

  h1 {
    margin-top: var(--s-2);
    font-size: var(--fs-2xl);
    letter-spacing: -0.02em;
  }

  .lede {
    margin-top: var(--s-3);
    max-width: 48ch;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .nf-nav {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .nf-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-3);
  }
</style>
