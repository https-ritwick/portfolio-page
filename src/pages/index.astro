---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Research from '../components/sections/Research.astro';
import Awards from '../components/sections/Awards.astro';
import Skills from '../components/sections/Skills.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
---

<!-- Order follows what a reviewer looks for: identity → work → experience → evidence → skills → background → contact. -->
<BaseLayout>
  <Hero />
  <Projects />
  <Experience />
  <Research />
  <Awards />
  <Skills />
  <About />
  <Contact />
</BaseLayout>
