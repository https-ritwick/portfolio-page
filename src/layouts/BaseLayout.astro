---
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
// Headings and the name use the serif — preload it so the first screen settles quickly.
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, socials, education } from '../data/profile';
import { absoluteUrl, withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page relative to the site root, for the canonical URL. */
  path?: string;
  noindex?: boolean;
}

const {
  title = `${profile.name} | ${profile.role}, Agentic AI & LLM Systems`,
  description = `${profile.name} is a software engineer (${profile.current.title} at ${profile.current.organization}) who builds multi-agent and RAG-based LLM systems. First author of FusionSight-YOLO (ETAAV 2025, IEEE) and Global Top 50 in the IBM watsonx Hackathon.`,
  path = '',
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path, Astro.site);
const ogImage = absoluteUrl('og.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.current.title,
  worksFor: { '@type': 'Organization', name: profile.current.organization },
  url: absoluteUrl('', Astro.site),
  image: absoluteUrl('favicon-192.png', Astro.site),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' },
  sameAs: socials.map((s) => s.href),
  alumniOf: education.map((e) => ({ '@type': 'EducationalOrganization', name: e.institution })),
  knowsAbout: ['Agentic AI', 'Multi-agent systems', 'Retrieval-augmented generation', 'Computer vision', 'Software engineering'],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('favicon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('sitemap.xml')} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}: ${profile.headline}`} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Theme + JS flag, applied before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
