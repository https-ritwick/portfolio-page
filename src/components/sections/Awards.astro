---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { achievements } from '../../data/achievements';
import { withBase } from '../../utils/url';
---

<section class="section" id="awards" aria-labelledby="awards-title">
  <div class="container">
    <SectionHead id="awards-title" title="Awards & competitions" />

    <ul class="awards" role="list" data-reveal>
      {
        achievements.map((a) => (
          <li class:list={['award', { 'award--major': a.tier === 'major' }]}>
            <p class="a-place serif">{a.placement}</p>
            <p class="a-event">
              {a.event}
              {a.note && <span class="a-note"> · {a.note}</span>}
            </p>
            {a.organizer && <p class="a-org">{a.organizer}</p>}
            {a.certificate && (
              <a class="icon-link a-cert" href={withBase(a.certificate)} target="_blank" rel="noopener">
                <Icon name="file-text" size={15} />
                <span>View certificate (PDF)</span>
                <Icon name="arrow-up-right" size={13} class="i-ext" />
                <span class="sr-only"> for {a.event} (opens in a new tab)</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .awards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }

  .award {
    padding: var(--s-5) var(--s-5) var(--s-5) 0;
    border-bottom: 1px solid var(--rule);
  }

  .award:not(:nth-child(3n + 1)) {
    padding-left: var(--s-5);
    border-left: 1px solid var(--rule);
  }

  .a-place {
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink-2);
  }

  .award--major .a-place {
    color: var(--accent);
  }

  .a-event {
    margin-top: var(--s-2);
    font-weight: 600;
    line-height: 1.4;
  }

  .a-note {
    font-weight: 400;
    color: var(--ink-2);
  }

  .a-org {
    margin-top: var(--s-1);
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }

  .a-cert {
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
  }

  @media (max-width: 860px) {
    .awards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .award,
    .award:not(:nth-child(3n + 1)) {
      padding: var(--s-4) var(--s-4) var(--s-4) 0;
      border-left: 0;
    }

    .award:nth-child(even) {
      padding-left: var(--s-4);
      border-left: 1px solid var(--rule);
    }
  }

  @media (max-width: 480px) {
    .awards {
      grid-template-columns: 1fr;
    }

    .award:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
