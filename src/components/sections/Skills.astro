---
import SectionHead from '../SectionHead.astro';
import { skillGroups } from '../../data/skills';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHead id="skills-title" title="Technical skills" />

    <dl class="skills" data-reveal>
      {
        skillGroups.map((g) => (
          <div class="skill-row">
            <dt>{g.label}</dt>
            <dd>{g.skills.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-7);
    border-top: 1px solid var(--ink);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  dd {
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
