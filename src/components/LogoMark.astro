---
/**
 * Personal mark: geometric lowercase "rj" with a cobalt tittle, on a tile.
 * Colours follow the theme tokens so it inverts cleanly in dark mode.
 * The same drawing (fixed colours) is used for the favicons — see scripts/generate-og.mjs.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={['mark', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <rect width="64" height="64" rx="14" class="mark-tile"></rect>
  <g fill="none" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" class="mark-letters">
    <path d="M21 46 V27"></path>
    <path d="M21 35 C21 29.5 25.5 26.5 32 27"></path>
    <path d="M43 27 V45 C43 51 39.5 54 33 53.5"></path>
  </g>
  <circle cx="43" cy="16.5" r="4.2" class="mark-dot"></circle>
</svg>

<style>
  .mark {
    flex-shrink: 0;
  }

  .mark-tile {
    fill: var(--ink);
  }

  .mark-letters {
    stroke: var(--bg);
  }

  .mark-dot {
    fill: #8ea9ff;
  }

  /* Light tile in dark mode, so the dot switches to the deeper cobalt. */
  :global(:root[data-theme='dark']) .mark-dot {
    fill: #1f48c9;
  }
</style>
