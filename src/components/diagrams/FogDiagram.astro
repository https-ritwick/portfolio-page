---
import DiagramFrame from './DiagramFrame.astro';

interface Props {
  figure?: string;
}

const tiers = [
  { head: 'DATA COLLECTION', label: 'IoT sensors', sub: 'ECG · pulse · glucose · BP', x: 10 },
  { head: 'FOG', label: 'fog nodes', sub: 'Raspberry Pi · Python', x: 200 },
  { head: 'CLOUD', label: 'Google Cloud', sub: 'storage · analytics', x: 390 },
];
---

<DiagramFrame
  figure={Astro.props.figure}
  title="IoT-Fog · layered architecture"
  caption="Simplified schematic. Sensor readings and user inputs go to Raspberry Pi fog nodes, which preprocess them and raise immediate alerts near the patient. The cloud stores history and runs the Scikit-learn prediction models, whose results reach patients, caregivers and doctors through dashboards."
>
  <svg viewBox="0 0 560 260" role="img" aria-label="IoT sensors such as ECG, pulse, glucose and blood pressure send data to Raspberry Pi fog nodes, which forward it to Google Cloud for storage and analytics. Fog nodes raise immediate alerts. The cloud runs Scikit-learn models for heart-disease and diabetes prediction, which feed a mobile app, web dashboard and REST API. Latency is lowest near the patient.">
    <defs>
      <marker id="fog-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" class="d-arrow--accent" />
      </marker>
      <marker id="fog-arrow-muted" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" class="d-arrow" />
      </marker>
    </defs>

    {
      tiers.map((t, i) => (
        <g>
          <text class="d-head" x={t.x} y="16">{t.head}</text>
          <line class="d-rule" x1={t.x} y1="24" x2={t.x + 160} y2="24" />
          <rect class:list={['d-box', i === 1 ? 'd-box--accent' : 'd-box--strong']} x={t.x} y="40" width="160" height="56" />
          <text class:list={['d-label', i === 1 && 'd-label--accent']} x={t.x + 80} y="64" text-anchor="middle">
            {t.label}
          </text>
          <text class="d-sub" x={t.x + 80} y="81" text-anchor="middle">{t.sub}</text>
          {i < tiers.length - 1 && (
            <path class="d-edge d-edge--accent" d={`M${t.x + 160} 68 L${t.x + 188} 68`} marker-end="url(#fog-arrow)" />
          )}
        </g>
      ))
    }

    <!-- prediction models in the cloud -->
    <path class="d-edge d-edge--accent" d="M470 96 L470 130" marker-end="url(#fog-arrow)" />
    <rect class="d-box d-box--strong" x="390" y="132" width="160" height="52" />
    <text class="d-label" x="470" y="154" text-anchor="middle">Scikit-learn</text>
    <text class="d-sub" x="470" y="171" text-anchor="middle">heart disease · diabetes</text>

    <!-- outputs: alerts from the fog, predictions from the cloud -->
    <path class="d-edge d-edge--dashed" d="M280 96 L280 132" />
    <path class="d-edge d-edge--accent" d="M390 158 L362 158" marker-end="url(#fog-arrow)" />
    <rect class="d-box d-box--strong" x="200" y="132" width="160" height="52" />
    <text class="d-label" x="280" y="154" text-anchor="middle">dashboards</text>
    <text class="d-sub" x="280" y="171" text-anchor="middle">app · web · REST API · alerts</text>

    <!-- latency axis -->
    <path class="d-edge" d="M550 232 L14 232" marker-end="url(#fog-arrow-muted)" />
    <text class="d-sub" x="10" y="252">lower latency</text>
    <text class="d-sub" x="550" y="252" text-anchor="end">further from the patient</text>
  </svg>
</DiagramFrame>
