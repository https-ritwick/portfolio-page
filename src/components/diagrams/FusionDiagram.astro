---
import DiagramFrame from './DiagramFrame.astro';

interface Props {
  figure?: string;
}

const inputs = [
  { label: 'EO frame', sub: 'RGB · 3 channels', y: 40 },
  { label: 'IR frame', sub: 'thermal → 3 channels', y: 116 },
];
---

<DiagramFrame
  figure={Astro.props.figure}
  title="FusionSight-YOLO · early fusion"
  caption="Simplified schematic. Each electro-optical frame is stacked with its paired infrared frame (replicated to three channels) into a 6-channel tensor. YOLOv8x's first convolution is widened to six input channels and initialised from the averaged pretrained RGB weights. See the paper for the full architecture."
>
  <svg viewBox="0 0 600 250" role="img" aria-label="A 3-channel EO frame and an IR frame replicated to 3 channels are concatenated into a 6-channel tensor. It feeds YOLOv8x with a 6-channel first convolution, which outputs object detections. Training uses SAGA augmentation, starts from pretrained YOLOv8x weights and is validated on IndraEye, LLVIP and M3FD.">
    <defs>
      <marker id="fu-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" class="d-arrow--accent" />
      </marker>
    </defs>

    <text class="d-head" x="10" y="16">PAIRED UAV IMAGERY</text>
    <line class="d-rule" x1="10" y1="22" x2="134" y2="22" />

    {
      inputs.map((input) => (
        <g>
          <rect class="d-box d-box--strong" x="10" y={input.y} width="124" height="46" />
          <text class="d-label" x="22" y={input.y + 20}>{input.label}</text>
          <text class="d-sub" x="22" y={input.y + 35}>{input.sub}</text>
          <path
            class="d-edge d-edge--accent"
            d={`M134 ${input.y + 23} C156 ${input.y + 23} 156 109 176 109`}
            marker-end="url(#fu-arrow)"
          />
        </g>
      ))
    }

    <rect class="d-box d-box--accent" x="178" y="80" width="118" height="58" />
    <text class="d-label d-label--accent" x="237" y="105" text-anchor="middle">concatenate</text>
    <text class="d-sub" x="237" y="121" text-anchor="middle">6-channel tensor</text>

    <path class="d-edge d-edge--accent" d="M296 109 L336 109" marker-end="url(#fu-arrow)" />

    <rect class="d-box d-box--strong" x="338" y="66" width="132" height="86" />
    <text class="d-label" x="404" y="96" text-anchor="middle">YOLOv8x</text>
    <text class="d-sub" x="404" y="113" text-anchor="middle">6-channel first conv</text>
    <text class="d-sub" x="404" y="128" text-anchor="middle">backbone · neck · head</text>

    <path class="d-edge d-edge--accent" d="M470 109 L494 109" marker-end="url(#fu-arrow)" />

    <rect class="d-box d-box--strong" x="496" y="66" width="94" height="86" />
    <rect class="d-target" x="508" y="80" width="30" height="22" />
    <rect class="d-target" x="548" y="94" width="30" height="30" />
    <text class="d-sub" x="543" y="142" text-anchor="middle">detections</text>

    <!-- training -->
    <rect class="d-box d-box--ghost" x="10" y="190" width="580" height="50" />
    <text class="d-sub" x="22" y="210">TRAINING · SAGA augmentation · pretrained YOLOv8x weights, then fine-tuned</text>
    <text class="d-sub" x="22" y="227">VALIDATION · IndraEye · LLVIP · M3FD</text>
  </svg>
</DiagramFrame>
