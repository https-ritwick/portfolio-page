---
import DiagramFrame from './DiagramFrame.astro';

interface Props {
  figure?: string;
}

const channels = ['channel 1', 'channel 2', 'channel n'];
const chY = (i: number) => 34 + i * 56;
---

<DiagramFrame
  figure={Astro.props.figure}
  title="FusionSight-YOLO · pipeline"
  caption="Simplified schematic. Multiple input channels from UAV imagery are fused at the input of a modified YOLOv8 detector. See the paper for the exact architecture."
>
  <svg viewBox="0 0 600 230" role="img" aria-label="Several input channels from UAV imagery feed an input-fusion stage, which feeds a modified YOLOv8 network that outputs object detections.">
    <defs>
      <marker id="fu-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" class="d-arrow--accent" />
      </marker>
    </defs>

    <text class="d-head" x="10" y="16">UAV IMAGERY</text>
    <line class="d-rule" x1="10" y1="22" x2="124" y2="22" />

    {
      channels.map((name, i) => (
        <g>
          <rect class="d-box d-box--strong" x="10" y={chY(i)} width="114" height="38" />
          {/* stacked-plane glyph */}
          <rect class="d-box" x="22" y={chY(i) + 11} width="14" height="14" />
          <rect class="d-box" x="25" y={chY(i) + 8} width="14" height="14" />
          <text class="d-label" x="48" y={chY(i) + 23}>{name}</text>
          <path
            class="d-edge d-edge--accent"
            d={`M124 ${chY(i) + 19} C150 ${chY(i) + 19} 150 109 176 109`}
            marker-end="url(#fu-arrow)"
          />
        </g>
      ))
    }

    <rect class="d-box d-box--accent" x="178" y="80" width="124" height="58" />
    <text class="d-label d-label--accent" x="240" y="106" text-anchor="middle">input fusion</text>
    <text class="d-sub" x="240" y="122" text-anchor="middle">multi-channel</text>

    <path class="d-edge d-edge--accent" d="M302 109 L340 109" marker-end="url(#fu-arrow)" />

    <rect class="d-box d-box--strong" x="342" y="70" width="124" height="78" />
    <text class="d-label" x="404" y="106" text-anchor="middle">YOLOv8</text>
    <text class="d-sub" x="404" y="122" text-anchor="middle">modified detector</text>

    <path class="d-edge d-edge--accent" d="M466 109 L494 109" marker-end="url(#fu-arrow)" />

    <rect class="d-box d-box--strong" x="496" y="70" width="94" height="78" />
    <rect class="d-target" x="508" y="82" width="30" height="22" />
    <rect class="d-target" x="548" y="96" width="30" height="30" />
    <text class="d-sub" x="543" y="142" text-anchor="middle">detections</text>
  </svg>
</DiagramFrame>
